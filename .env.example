# --- Supabase ---
# URL del proyecto, ej: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Clave "anon" (pública) — va en el cliente del navegador
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave "service_role" (SOLO backend, nunca exponerla al navegador).
# Usada por las API routes / server actions para operaciones admin.
SUPABASE_SERVICE_ROLE_KEY=
# Nombre del bucket de storage para los assets de la tienda
SUPABASE_STORAGE_BUCKET=rutex
# Nombre del bucket (lado cliente, para construir URLs públicas)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=rutex
# Prefijo de la URL pública de los archivos (para getAssetUrl)
NEXT_PUBLIC_SUPABASE_STORAGE_URL=

# --- Cifrado de datos sensibles ---
# Clave AES-256-GCM (32 bytes) en hexadecimal (64 caracteres) para cifrar en
# reposo los números de cuenta bancaria. GENERAR CON: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OJO: si se cambia, los datos cifrados viejos ya no se podrán descifrar.
BANK_ACCOUNT_ENC_KEY=
